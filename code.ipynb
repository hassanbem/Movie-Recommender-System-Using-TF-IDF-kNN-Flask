#Imports


#Import all the required packages
import requests
import gzip
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.metrics.pairwise import cosine_similarity

## Data Collection

#URL to fetch all the 6 files.
urls = ['https://datasets.imdbws.com/title.basics.tsv.gz',
        'https://datasets.imdbws.com/title.crew.tsv.gz',
        'https://datasets.imdbws.com/title.akas.tsv.gz',
        'https://datasets.imdbws.com/title.ratings.tsv.gz',
        'https://datasets.imdbws.com/name.basics.tsv.gz',
        'https://datasets.imdbws.com/title.principals.tsv.gz']

#Fetch the data using the above URL and extract all the files.
for url in urls:
    response = requests.get(url)
    filename = url.split("/")[-1]

    with open(filename, 'wb') as f:
        f.write(response.content)

    with gzip.open(filename, 'rb') as f_in:
        with open(filename[:-3], 'wb') as f_out:
            f_out.write(f_in.read())

    print(f"Extracted file: {filename[:-3]}")

## Data Preparation

# -----------------------------
# 1. Load title.basics
# -----------------------------
title_basics = pd.read_csv(
    "title.basics.tsv",
    sep="\t",
    usecols=['tconst', 'titleType', 'primaryTitle', 'startYear', 'runtimeMinutes', 'genres'],
    dtype={'startYear': str},
    na_values=['\\N'],
    low_memory=False
)

title_basics['startYear'] = pd.to_numeric(title_basics['startYear'], errors='coerce')

# Filter only movies from 2019 to 2024
title_basics = title_basics[(title_basics['titleType'] == 'movie') & (title_basics['startYear'] >= 2019) & (title_basics['startYear'] <= 2024)]
print("Movies remaining:", len(title_basics))


# -----------------------------
# 2. Load other datasets
# -----------------------------
title_crew = pd.read_csv(
    "title.crew.tsv",
    sep="\t",
    usecols=["tconst", "directors", "writers"],
    na_values=['\\N']
)

title_ratings = pd.read_csv(
    "title.ratings.tsv",
    sep="\t",
    usecols=["tconst", "averageRating", "numVotes"],
    na_values=['\\N']
)

title_principals = pd.read_csv(
    "title.principals.tsv",
    sep="\t",
    usecols=["tconst", "nconst", "category"],
    dtype={"nconst": str},
    na_values=['\\N']
)

title_principals = title_principals[title_principals['category'].isin(['actor', 'actress'])]

names = pd.read_csv(
    "name.basics.tsv",
    sep="\t",
    usecols=["nconst", "primaryName"],
    dtype={"nconst": str}
)

name_map = dict(zip(names['nconst'], names['primaryName']))


# -----------------------------
# 3. Merge datasets
# -----------------------------
df = title_basics.merge(title_crew, on="tconst", how="left")
df = df.merge(title_ratings, on="tconst", how="left")
df = df.merge(title_principals, on="tconst", how="left")


# -----------------------------
# 4. Map directors and writers
# -----------------------------
df['directors'] = df['directors'].fillna('').astype(str)
df['writers'] = df['writers'].fillna('').astype(str)

df['directors'] = df['directors'].str.split(',').apply(
    lambda lst: ', '.join([name_map.get(x, x) for x in lst if x])
)

df['writers'] = df['writers'].str.split(',').apply(
    lambda lst: ', '.join([name_map.get(x, x) for x in lst if x])
)


# -----------------------------
# 5. Map actors
# -----------------------------
df['actors'] = df['nconst'].apply(
    lambda x: name_map.get(x, x) if pd.notna(x) else ''
)

df['actors'] = df['actors'].fillna('').astype(str)


# -----------------------------
# 6. Clean and group duplicates
# -----------------------------
df = df.drop(['nconst', 'category'], axis=1)

df = df.groupby(['tconst', 'titleType']).agg({
    'primaryTitle': 'first',
    'startYear': 'first',
    'runtimeMinutes': 'first',
    'genres': 'first',
    'directors': 'first',
    'writers': 'first',
    'averageRating': 'first',
    'numVotes': 'first',

    # 🟢 KEEP ONLY 5 ACTORS HERE
    'actors': lambda x: ', '.join(sorted(set([a for a in x if a.strip()]))[:5])

}).reset_index()


# -----------------------------
# 7. Final cleaning + Movie label
# -----------------------------
df['Year'] = df['startYear'].astype('Int64')

df['Movie'] = df.apply(
    lambda row: f"{row['primaryTitle']} ({row['Year']})"
    if pd.notna(row['Year'])
    else row['primaryTitle'],
    axis=1
)

df.head()


del title_basics
del title_crew
del title_ratings
del title_principals
del names

df.head()

df['runtimeMinutes'] = df['runtimeMinutes'].fillna(0)
df['titleType'] = df['titleType'].astype(str)
df['runtimeMinutes'] = pd.to_numeric(df['runtimeMinutes'], errors='coerce')

# create a boxplot of runtimeMinutes by titleType category
df.boxplot(column=['runtimeMinutes'], by='titleType', figsize=(10, 6))

# set the title and axes labels
plt.title('Boxplot of runtimeMinutes by titleType category')
plt.xlabel('titleType')
plt.ylabel('Runtime (minutes)')

# show the plot
plt.show()

highest_runtime_row = df.sort_values(by='runtimeMinutes', ascending=False).iloc[0]

highest_runtime_row

#We can drop some unusually high runtime values.
df_check = df[(df['runtimeMinutes'] >= 45) & (df['runtimeMinutes'] <= 400)]

df_check.boxplot(column=['runtimeMinutes'], by='titleType', figsize=(10, 6))
plt.title('Boxplot of runtimeMinutes by titleType category')
plt.xlabel('titleType')
plt.ylabel('Runtime (minutes)')
plt.show()

df.to_csv('test2020UPDATED.csv')

df = pd.read_csv("test2020UPDATED.csv")

#Feature Engineering

from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.neighbors import NearestNeighbors
# Combine the relevant columns into a single "content" column
df['content'] = df['Movie'].astype(str) + ' ' + df['runtimeMinutes'].astype(str) + ' ' + df['genres'] + ' ' + df['directors'] + ' ' + df['writers'] + ' ' + df['averageRating'].astype(str) + ' ' + df['numVotes'].astype(str) + df['actors'].astype(str)

#Data Cleaning to take care of NaN in content column [It replaces NaN with empty strings]
df['content'] = df['Movie'].astype(str) + ' ' + df['runtimeMinutes'].astype(str) + ' ' + df['genres'] + ' ' + df['directors'] + ' ' + df['writers'] + ' ' + df['averageRating'].astype(str) + ' ' + df['numVotes'].astype(str) + df['actors'].astype(str)
df['content'] = df['content'].fillna('')

# vectorize content
tfidf = TfidfVectorizer()
tfidf_matrix = tfidf.fit_transform(df['content'])

#Model Training



# use Nearest Neighbors instead of full cosine matrix
model_knn = NearestNeighbors(metric='cosine', algorithm='brute')
model_knn.fit(tfidf_matrix)

def recommend_movie(title, n_recommendations=5):
    if title not in df['Movie'].values:
        return ["Movie not found"]

    idx = df.index[df['Movie'] == title][0]

    distances, indices = model_knn.kneighbors(
        tfidf_matrix[idx],
        n_neighbors=n_recommendations + 1
    )

    recommendations = df.iloc[indices[0][1:]]['Movie'].tolist()
    return recommendations
